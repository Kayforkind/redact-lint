{
  "name": "redact-lint",
  "version": "0.3.1",
  "description": "Catch fake redaction in PDFs before they ship.",
  "type": "module",
  "bin": {
    "redact-lint": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/analyze.d.mts",
      "import": "./src/analyze.mjs"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pdf",
    "redaction",
    "security",
    "cli",
    "pii",
    "lint",
    "pdfjs",
    "leak"
  ],
  "author": "NavigatorsLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayforkind/redact-lint.git"
  },
  "homepage": "https://github.com/Kayforkind/redact-lint#readme",
  "bugs": {
    "url": "https://github.com/Kayforkind/redact-lint/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/run.mjs",
    "bench:check": "node bench/run.mjs --check",
    "perf:check": "node scripts/perf-check.mjs",
    "typecheck": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "pdfkit": "^0.15.2",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  },
  "types": "./src/analyze.d.mts"
}
